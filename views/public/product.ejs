<% 
const pageTitle = typeof product !== 'undefined' ? product.name : 'Ürün Detayı';
const activeMenu = 'products';
const description = typeof product !== 'undefined' && product.description ? product.description.substring(0, 160) : '';
%>
<%- include('../partials/public_header') %>

<section class="container my-5">
    <% if (typeof product !== 'undefined') { %>
        <div class="row">
            <div class="col-lg-6 mb-4">
                <% if (product.images && product.images.length > 0) { %>
                    <div id="productImageCarousel" class="carousel slide" data-bs-ride="carousel">
                        <div class="carousel-indicators">
                            <% product.images.forEach((_, index) => { %>
                                <button type="button" data-bs-target="#productImageCarousel" 
                                        data-bs-slide-to="<%= index %>" 
                                        class="<%= index === 0 ? 'active' : '' %>"></button>
                            <% }) %>
                        </div>
                        <div class="carousel-inner">
                            <% product.images.forEach((image, index) => { %>
                                <div class="carousel-item <%= index === 0 ? 'active' : '' %>">
                                    <img src="<%= image.image_url %>" class="d-block w-100" 
                                         style="max-height: 500px; object-fit: cover; border-radius: 10px;"
                                         alt="<%= product.name %>">
                                </div>
                            <% }) %>
                        </div>
                        <% if (product.images.length > 1) { %>
                            <button class="carousel-control-prev" type="button" data-bs-target="#productImageCarousel" data-bs-slide="prev">
                                <span class="carousel-control-prev-icon"></span>
                            </button>
                            <button class="carousel-control-next" type="button" data-bs-target="#productImageCarousel" data-bs-slide="next">
                                <span class="carousel-control-next-icon"></span>
                            </button>
                        <% } %>
                    </div>
                <% } else { %>
                    <div class="bg-secondary text-white d-flex align-items-center justify-content-center" 
                         style="height: 500px; border-radius: 10px;">
                        <i class="fas fa-image fa-5x"></i>
                    </div>
                <% } %>
            </div>
            
            <div class="col-lg-6">
                <h1 class="mb-3"><%= product.name %></h1>
                
                <% if (product.category) { %>
                    <p class="text-muted">
                        <i class="fas fa-tag"></i> Kategori: <strong><%= product.category %></strong>
                    </p>
                <% } %>
                
                <hr>
                
                <div class="mb-4">
                    <h5>Ürün Açıklaması</h5>
                    <p><%= product.description || 'Açıklama bulunmuyor.' %></p>
                </div>
                
                <div class="d-grid gap-2">
                    <a href="/contact" class="btn btn-primary btn-lg">
                        <i class="fas fa-envelope"></i> Bilgi Al
                    </a>
                    <a href="/products" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left"></i> Ürünlere Dön
                    </a>
                </div>
            </div>
        </div>
    <% } else { %>
        <div class="text-center py-5">
            <i class="fas fa-exclamation-triangle fa-5x text-warning mb-3"></i>
            <h3>Ürün bulunamadı</h3>
            <a href="/products" class="btn btn-primary mt-3">
                <i class="fas fa-arrow-left"></i> Ürünlere Dön
            </a>
        </div>
    <% } %>
</section>

<%- include('../partials/public_footer') %>
