<%- include('../partials/public_header', { title: 'Hakkımızda - Kartal Metal İş' }) %>

    <!-- Hero Section -->
    <section class="hero-section"
        style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 100px 0; color: white;">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-8 mx-auto text-center">
                    <h1 class="display-4 fw-bold mb-3" data-aos="fade-up">Hakkımızda</h1>
                    <p class="lead" data-aos="fade-up" data-aos-delay="100">
                        <%= settings.site_description
                            || 'Kartal Metal İş olarak, sektördeki en yüksek kalite standartlarına uygun metal işleme hizmetleri sunuyoruz.'
                            %>
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Mission & Vision Section -->
    <section class="py-5 bg-light">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-6" data-aos="fade-right">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center mb-3">
                                <div class="icon-box bg-primary text-white rounded-circle p-3 me-3">
                                    <i class="fas fa-bullseye fa-2x"></i>
                                </div>
                                <h3 class="mb-0">Misyonumuz</h3>
                            </div>
                            <p class="text-muted">
                                <%= settings.about_mission
                                    || 'Kartal Metal İş olarak, sektördeki en yüksek kalite standartlarına uygun metal işleme hizmetleri sunarak, müşteri memnuniyetini en üst düzeyde tutmayı amaçlıyoruz.'
                                    %>
                            </p>
                        </div>
                    </div>
                </div>

                <div class="col-md-6" data-aos="fade-left">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center mb-3">
                                <div class="icon-box bg-success text-white rounded-circle p-3 me-3">
                                    <i class="fas fa-eye fa-2x"></i>
                                </div>
                                <h3 class="mb-0">Vizyonumuz</h3>
                            </div>
                            <p class="text-muted">
                                <%= settings.about_vision
                                    || 'Metal işleme alanında öncü bir firma olarak, sürdürülebilir ve çevre dostu çözümlerle sektöre yön vermeyi hedefliyoruz.'
                                    %>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- About Content Section -->
    <section class="py-5">
        <div class="container">
            <div class="row g-4 align-items-center mb-5">
                <div class="col-lg-6" data-aos="fade-right">
                    <img src="<%= settings.about_image_1 || '/resimler/kaynak-nedir-kaynak-cesitleri-1200x720.jpg' %>"
                        alt="Metal İşleme" class="img-fluid rounded shadow" loading="lazy">
                </div>
                <div class="col-lg-6" data-aos="fade-left">
                    <h2 class="mb-4">Deneyim ve Uzmanlık</h2>
                    <p class="text-muted">
                        <%= settings.about_content_1
                            || 'Kartal Metal İş, yılların tecrübesi ve sektördeki uzmanlığı ile metal işleme ve üretim alanında hizmet veren öncü bir firmadır.'
                            %>
                    </p>
                </div>
            </div>

            <div class="row g-4 align-items-center">
                <div class="col-lg-6 order-lg-2" data-aos="fade-left">
                    <img src="<%= settings.about_image_2 || '/resimler/ERATAVINC-1.jpg' %>" alt="Üretim"
                        class="img-fluid rounded shadow" loading="lazy">
                </div>
                <div class="col-lg-6 order-lg-1" data-aos="fade-right">
                    <h2 class="mb-4">Sürdürülebilirlik ve Kalite</h2>
                    <p class="text-muted">
                        <%= settings.about_content_2
                            || 'Kartal Metal İş, yalnızca ürünlerin kalitesine odaklanmakla kalmaz, aynı zamanda sürdürülebilirlik ve çevreye duyarlılık konularına da büyük önem verir.'
                            %>
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Values Section -->
    <section class="py-5 bg-light">
        <div class="container">
            <div class="row text-center mb-5">
                <div class="col-12" data-aos="fade-up">
                    <h2 class="mb-3">Değerlerimiz</h2>
                    <p class="text-muted">Metal işleme sanatını tutkuyla icra ederken, geleceği şekillendiren çözümler
                        sunuyoruz</p>
                </div>
            </div>

            <div class="row g-4">
                <div class="col-md-3 col-sm-6" data-aos="fade-up" data-aos-delay="0">
                    <div class="text-center p-4 bg-white rounded shadow-sm h-100">
                        <div class="icon-box bg-primary text-white rounded-circle p-3 d-inline-block mb-3">
                            <i class="fas fa-shipping-fast fa-2x"></i>
                        </div>
                        <h5>Hızlı Teslimat</h5>
                        <p class="text-muted small mb-0">48 saat içinde teslimat</p>
                    </div>
                </div>

                <div class="col-md-3 col-sm-6" data-aos="fade-up" data-aos-delay="100">
                    <div class="text-center p-4 bg-white rounded shadow-sm h-100">
                        <div class="icon-box bg-success text-white rounded-circle p-3 d-inline-block mb-3">
                            <i class="fas fa-award fa-2x"></i>
                        </div>
                        <h5>Yılların Deneyimi</h5>
                        <p class="text-muted small mb-0">7+ yıl sektör tecrübesi</p>
                    </div>
                </div>

                <div class="col-md-3 col-sm-6" data-aos="fade-up" data-aos-delay="200">
                    <div class="text-center p-4 bg-white rounded shadow-sm h-100">
                        <div class="icon-box bg-info text-white rounded-circle p-3 d-inline-block mb-3">
                            <i class="fas fa-truck fa-2x"></i>
                        </div>
                        <h5>Ücretsiz Kargo</h5>
                        <p class="text-muted small mb-0">Tüm siparişlerde</p>
                    </div>
                </div>

                <div class="col-md-3 col-sm-6" data-aos="fade-up" data-aos-delay="300">
                    <div class="text-center p-4 bg-white rounded shadow-sm h-100">
                        <div class="icon-box bg-warning text-white rounded-circle p-3 d-inline-block mb-3">
                            <i class="fas fa-star fa-2x"></i>
                        </div>
                        <h5>Yüksek Kalite</h5>
                        <p class="text-muted small mb-0">Garanti ve güvence</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <%- include('../partials/public_footer') %>