# Database
DB_NAME=kartal_metal_db
DB_USER=postgres
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=5432

# App
PORT=3008
NODE_ENV=production

# Secrets (change these!)
SESSION_SECRET=replace_with_strong_random_string
JWT_SECRET=replace_with_strong_random_string

# Security
CORS_ORIGIN=false # or https://yourdomain.com
COOKIE_MAX_AGE=86400000
BCRYPT_ROUNDS=12

# Rate limits
API_RATE_WINDOW=15
API_RATE_LIMIT=100
LOGIN_RATE_WINDOW=15
LOGIN_RATE_LIMIT=5

# Uploads
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,image/jpg
