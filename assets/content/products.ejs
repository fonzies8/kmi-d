                                            <script>
                                                // Ürün verilerini backend'den çekip HTML'e yerleştirme
                                                fetch('/products')
                                                    .then(response => response.json())
                                                    .then(products => {
                                                        const productList = document.getElementById('product-list');
                                        
                                                        products.forEach(product => {
                                                            const li = document.createElement('li');
                                                            li.classList.add('isotope-item', 'product', 'type-product');
                                        
                                                            li.innerHTML = `
                                                                <div class="image_frame scale-with-grid product-loop-thumb" ontouchstart="this.classList.toggle('hover');">
                                                                    <div class="image_wrapper">
                                                                        <a href="product.html?id=${product.id}">
                                                                            <div class="mask"></div>
                                                                            <img width="600" height="600" src="images/${product.image_name}" class="scale-with-grid wp-post-image" alt="${product.name}">
                                                                        </a>
                                                                        <div class="image_links double">
                                                                            <a class="add_to_cart_button" href="product.html?id=${product.id}"><i class="icon-basket"></i></a>
                                                                            <a class="link" href="product.html?id=${product.id}"><i class="icon-link"></i></a>
                                                                        </div>
                                                                    </div>
                                                                    <a href="product.html?id=${product.id}"><span class="product-loading-icon added-cart"></span></a>
                                                                </div>
                                                                <div class="desc">
                                                                    <h4><a href="product.html?id=${product.id}">${product.name}</a></h4>
                                                                    <span class="price">${product.explanation}</span>
                                                                </div>
                                                            `;
                                        
                                                            productList.appendChild(li);
                                                        });
                                                    })
                                                    .catch(error => console.error('Ürün verileri alınırken hata oluştu:', error));
                                            </script>
                                            
